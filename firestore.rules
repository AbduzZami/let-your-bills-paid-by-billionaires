rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bills/{billId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.proofData is string
        && request.resource.data.proofData.matches('data:image/.*')
        && request.resource.data.proofData.size() < 800000;

      allow update: if request.auth != null
        && resource.data.status == 'open'
        && resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'paid'
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidBy', 'paidByName', 'paidAt', 'txnRef']);

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
